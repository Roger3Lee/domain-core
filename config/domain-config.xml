<domains>
    <domain name="family" description="家庭领域模型" main-table="family">
        <related description="家庭成员" table="family_member" many="true" fk="id:family_id" redundancy="name:family_name">
            <!-- 引用关系：成员绑定的住址（一对一） -->
            <ref name="address" description="成员住址绑定" table="family_address" many="false" fk="id:family_member_id"/>
        </related>
        <related description="家庭住址" table="family_address" many="true" fk="id:family_id" redundancy="name:family_name"/>
    </domain>
</domains>